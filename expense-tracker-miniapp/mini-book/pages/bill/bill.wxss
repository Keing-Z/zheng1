.page { min-height: 100vh; padding-bottom: 40rpx; }

/* 月份 */
.monthbar {
  display: flex;
  align-items: center;
  background: #fff;
  padding: 24rpx 32rpx;
  border-bottom: 2rpx solid #f0f1f6;
}
.nav {
  width: 72rpx;
  height: 72rpx;
  border-radius: 20rpx;
  background: #f5f6fa;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  color: #4f46e5;
}
.nav.disabled { opacity: 0.3; }
.m-inner { flex: 1; text-align: center; display: flex; flex-direction: column; }
.m-label { font-size: 32rpx; font-weight: 700; }
.m-sub { font-size: 22rpx; color: #9aa0b4; margin-top: 2rpx; }

/* 筛选 */
.filter { white-space: nowrap; padding: 20rpx 24rpx 8rpx; }
.fchip {
  display: inline-block;
  padding: 12rpx 24rpx;
  margin-right: 12rpx;
  border-radius: 999rpx;
  background: #fff;
  font-size: 24rpx;
  color: #7b8199;
  border: 2rpx solid #eef0f6;
}
.fchip.on { background: #4f46e5; color: #fff; border-color: #4f46e5; font-weight: 600; }

/* 列表 */
.list { padding: 16rpx 24rpx; }
.day { margin-bottom: 24rpx; }
.day-head {
  display: flex;
  justify-content: space-between;
  padding: 8rpx 8rpx 12rpx;
  font-size: 24rpx;
  color: #9aa0b4;
}
.day-total { color: #7b8199; }

.rec {
  display: flex;
  align-items: center;
  background: #fff;
  border-radius: 20rpx;
  padding: 20rpx 22rpx;
  margin-bottom: 12rpx;
}
.rec:active { background: #fafbfe; }
.rec-ico {
  width: 72rpx;
  height: 72rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  margin-right: 20rpx;
  flex-shrink: 0;
}
.rec-main { flex: 1; min-width: 0; }
.rec-top { display: flex; justify-content: space-between; align-items: baseline; }
.rec-cat { font-size: 30rpx; font-weight: 600; }
.rec-amt { font-size: 30rpx; font-weight: 700; color: #1f2333; }
.rec-note {
  display: block;
  font-size: 24rpx;
  color: #9aa0b4;
  margin-top: 4rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.tip { text-align: center; font-size: 22rpx; color: #b6bacb; padding: 20rpx; }
