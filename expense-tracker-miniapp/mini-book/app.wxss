/* 全局样式 */
page {
  background: #f5f6fa;
  color: #1f2333;
  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Helvetica Neue', sans-serif;
  font-size: 30rpx;
  line-height: 1.5;
}

view, text, scroll-view { box-sizing: border-box; }

.container { padding: 24rpx; }

/* 卡片 */
.card {
  background: #fff;
  border-radius: 28rpx;
  padding: 28rpx;
  box-shadow: 0 2rpx 4rpx rgba(20, 24, 50, 0.04), 0 12rpx 32rpx rgba(20, 24, 50, 0.04);
  margin-bottom: 24rpx;
}

.title { font-size: 32rpx; font-weight: 700; }
.muted { color: #7b8199; font-size: 24rpx; }
.row { display: flex; align-items: center; }
.between { display: flex; align-items: center; justify-content: space-between; }
.center { display: flex; align-items: center; justify-content: center; }

.empty {
  text-align: center;
  color: #9aa0b4;
  font-size: 26rpx;
  padding: 80rpx 0;
}
.empty .em { display: block; font-size: 80rpx; margin-bottom: 16rpx; opacity: 0.5; }

.tag {
  display: inline-block;
  font-size: 22rpx;
  padding: 4rpx 14rpx;
  border-radius: 10rpx;
  background: #f2f3f8;
  color: #7b8199;
}
.tag.red { background: #fdecec; color: #e5484d; }
.tag.orange { background: #fff4e5; color: #c77700; }
.tag.green { background: #e8f7f4; color: #12a594; }

.btn-primary {
  background: #4f46e5;
  color: #fff;
  border-radius: 24rpx;
  padding: 26rpx;
  text-align: center;
  font-size: 32rpx;
  font-weight: 600;
  box-shadow: 0 12rpx 28rpx rgba(79, 70, 229, 0.28);
}
.btn-primary:active { background: #4338ca; }
.btn-ghost {
  background: #fff;
  color: #1f2333;
  border: 2rpx solid #e6e8f0;
  border-radius: 20rpx;
  padding: 18rpx 28rpx;
  font-size: 28rpx;
  text-align: center;
}
